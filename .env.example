# ---------- Server ----------
PORT=3000
JWT_SECRET=change-this-to-a-long-random-string
JWT_EXPIRES_IN=7d

# ---------- MongoDB ----------
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DB=medireminder

# ---------- Scheduler ----------
# How often the server-side scheduler checks for due reminders (seconds)
SCHEDULER_INTERVAL_SEC=30
# A reminder that is still pending this many minutes after it is due is marked Missed
MISSED_AFTER_MIN=60

# ---------- Email notifications (optional) ----------
# Leave SMTP_HOST empty to run in MOCK mode: emails are printed in the server console.
# For a free test inbox use https://ethereal.email (create account, paste credentials below).
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM="MediReminder <no-reply@medireminder.local>"
