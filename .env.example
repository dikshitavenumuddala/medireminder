# ---------- Server ----------
PORT=3000
JWT_SECRET=
JWT_EXPIRES_IN=7d

# ---------- MongoDB ----------
# Local development: use the MongoDB instance running on your computer.
# Vercel: MONGODB_URI must point to a secure, externally reachable tunnel endpoint;
# 127.0.0.1/localhost on Vercel refers to the serverless function, not your computer.
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DB=medireminder

# ---------- Vercel cron ----------
# Set this in Vercel so scheduled requests to /api/cron are authenticated.
CRON_SECRET=

# ---------- Scheduler ----------
# How often the server-side scheduler checks for due reminders (seconds)
SCHEDULER_INTERVAL_SEC=30
# A reminder that is still pending this many minutes after it is due is marked Missed
MISSED_AFTER_MIN=60

# ---------- Email notifications (optional) ----------
# Leave SMTP_HOST empty to run in MOCK mode: emails are printed in the server console.
# For a free test inbox use https://ethereal.email (create account, paste credentials below).
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM="MediReminder <no-reply@medireminder.local>"
